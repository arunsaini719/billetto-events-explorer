<% content_for :head do %>
  <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css",
        integrity: "sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB",
        crossorigin: "anonymous", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css",
        integrity: "sha384-CK2SzKma4jA5H/MXDUU7i1TqZlCFaD4T01vtyDFvPlD97JQyS+IsSh1nI2EFbpyk",
        crossorigin: "anonymous", "data-turbo-track": "reload" %>
<% end %>

<div class="min-vh-100 bg-body-tertiary">
  <header class="border-bottom bg-white">
    <div class="container d-flex flex-wrap align-items-center justify-content-between gap-2 py-3">
      <%= link_to "Billetto Events Explorer", root_path, class: "fw-semibold text-dark text-decoration-none" %>
      <%= render "layouts/account_navigation" if show_account_navigation? %>
    </div>
  </header>

  <section class="container py-4 py-lg-5" aria-labelledby="events-title">
    <h1 id="events-title" class="display-5 fw-bold">Upcoming events</h1>
    <p class="text-body-secondary mb-4">Find concerts, workshops, and more. Soonest events first.</p>

    <% if @events.empty? %>
      <p class="border rounded-3 bg-white p-4">No upcoming events to show.</p>
    <% end %>

    <div id="event-listings" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
      <%= render @events %>
    </div>

    <%= render "events/pagination" %>
  </section>
</div>
