<article id="<%= dom_id(event) %>" class="col">
  <div class="card h-100 overflow-hidden border-0 shadow-sm">
    <div class="ratio ratio-16x9 bg-body-secondary">
      <% if event.image_url&.start_with?("https://") %>
        <%= image_tag event.image_url, alt: "", class: "object-fit-cover", loading: "lazy", decoding: "async" %>
      <% else %>
        <div class="d-grid align-items-center text-center text-body-secondary" aria-hidden="true">No image available</div>
      <% end %>
    </div>

    <div class="card-body d-flex flex-column">
      <p class="small fw-semibold text-primary mb-2">
        <time datetime="<%= event.starts_at.iso8601 %>"><%= event.starts_at.utc.strftime("%a, %d %b %Y · %H:%M UTC") %></time>
      </p>
      <h2 class="card-title h5"><%= event.title %></h2>
      <p class="card-text text-body-secondary"><%= truncate(strip_tags(event.description.to_s).squish, length: 150).presence || "No description available." %></p>

      <% if event.billetto_url&.start_with?("https://") %>
        <%= link_to "View on Billetto", event.billetto_url, target: "_blank", rel: "noopener",
              class: "mt-auto align-self-start fw-semibold text-decoration-none" %>
      <% end %>

      <%= render "events/votes", event: event, summary: @vote_summaries.fetch(event.id),
            viewer_reaction: @viewer_reactions[event.id] %>
    </div>
  </div>
</article>
