<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Billetto Events Explorer" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= render "layouts/clerk_scripts" if clerk_browser_needed? %>
    <%= javascript_importmap_tags %>
  </head>

  <%= tag.body(**page_body_attributes) do %>
    <%= render "layouts/account_navigation" if show_account_navigation? %>
    <% if clerk_browser_needed? %>
      <p role="alert" data-clerk-target="error" hidden></p>
    <% end %>
    <main><%= yield %></main>
  <% end %>
</html>
