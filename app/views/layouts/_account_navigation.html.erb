<nav class="d-flex align-items-center gap-2" aria-label="Account">
  <% if clerk_signed_in? %>
    <button type="button" class="btn btn-danger btn-sm" data-clerk-target="logout" data-action="clerk#signOut" disabled>
      <span class="bi bi-box-arrow-right me-1" aria-hidden="true"></span>Log out
    </button>
  <% else %>
    <%= link_to sign_in_path, class: "btn btn-outline-primary btn-sm", data: { turbo: false } do %>
      <span class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></span>Sign in
    <% end %>
    <%= link_to sign_up_path, class: "btn btn-primary btn-sm", data: { turbo: false } do %>
      <span class="bi bi-person-plus me-1" aria-hidden="true"></span>Sign up
    <% end %>
  <% end %>
</nav>
